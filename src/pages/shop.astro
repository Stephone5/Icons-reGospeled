---
import Base from '../layouts/Base.astro';

// Pull live products from the Printful storefront at build time.
// The store is an Inertia app: all product data is embedded in the page's
// data-page attribute. We parse it so the site mirrors Printful automatically
// (the daily cron rebuild keeps images, prices, and items in sync).
const STORE = 'https://iconsrg.printful.me';
let products = [];
try {
  const res = await fetch(STORE, { headers: { 'User-Agent': 'Mozilla/5.0' } });
  if (res.ok) {
    const html = await res.text();
    const m = html.match(/data-page="([^"]*)"/s);
    if (m) {
      const json = m[1]
        .replace(/&quot;/g, '"')
        .replace(/&#039;/g, "'")
        .replace(/&lt;/g, '<')
        .replace(/&gt;/g, '>')
        .replace(/&amp;/g, '&');
      const data = JSON.parse(json);
      products = (data?.props?.products || []).map((p) => ({
        name: p.name,
        price: p.min_price,
        img: p.imageUrl,
        url: `${STORE}/product/${p.slug}`,
      }));
    }
  }
} catch (e) {}
const money = (n) => (n == null ? '' : `$${Number(n).toFixed(2)}`);
---
<Base title="Shop, Icons reGospeled" description="Tees, dad hats, whiskey glasses, and more from Icons reGospeled. Every order supports the ministry.">

  <section class="hero" style="padding-bottom:0;">
    <div class="wrap">
      <h1 class="stitle">Wear the good news</h1>
      <p class="lead">Tees, dad hats, beanies, and whiskey glasses, including "IrG Edition," "Apokatastasis," and "Live, Laugh, Apokatastasis." Every order helps support the ministry.</p>
    </div>
  </section>

  <section data-reveal>
    <div class="wrap">
      {products.length ? (
        <div class="shop-grid">
          {products.map((p) => (
            <a class="product" href={p.url}>
              <div class="product-img">
                <img src={p.img} alt={p.name} loading="lazy" decoding="async" width="600" height="600">
              </div>
              <div class="product-meta">
                <h3>{p.name}</h3>
                <span class="price">{p.price ? `From ${money(p.price)}` : 'View'}</span>
              </div>
            </a>
          ))}
        </div>
        <p style="text-align:center;color:var(--muted);font-size:15px;margin-top:32px;">
          Fulfilled by Printful. Final prices and options shown at checkout.
        </p>
      ) : (
        <div class="narrow" style="text-align:center;">
          <p class="lead">Our full store is over on Printful.</p>
          <div class="cta-row center" style="margin-top:20px;">
            <a class="btn btn-gold" href={STORE}>Browse the shop →</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="narrow">
      <h2>Prefer to give directly?</h2>
      <p class="lead">Support the ministry with a one-time or recurring gift.</p>
      <div class="cta-row center" style="margin-top:24px;">
        <a class="btn btn-gold" href="/give/">Give a gift →</a>
      </div>
    </div>
  </section>

</Base>
