---
import Base from '../layouts/Base.astro';
---
<Base title="Shop, Icons reGospeled" description="Tees, dad hats, and whiskey glasses from Icons reGospeled, 'IrG Edition', 'Apokatastasis', and 'Live, Laugh, Apokatastasis'. Proceeds support the ministry.">

  <section class="hero" style="padding-bottom:0;">
    <div class="wrap">
      <p class="eyebrow">The shop</p>
      <h1>Wear the good news.</h1>
      <p class="lead">Tees, dad hats, and whiskey glasses, including "IrG Edition," "Apokatastasis," and "Live, Laugh, Apokatastasis." Every order helps support the ministry.</p>
      <div class="cta-row center" style="margin-top:26px;">
        <a class="btn btn-gold" href="https://iconsrg.printful.me">Browse the shop →</a>
      </div>
    </div>
  </section>

  <section data-reveal>
    <div class="wrap">
      <div class="grid cols-3" style="max-width:900px;margin:0 auto;">
        <a class="card" href="https://iconsrg.printful.me"><div class="tag">Apparel</div><h3>Tees</h3><p>Soft, honest, and quietly heretical. From about $23.50.</p><span class="go">Shop tees →</span></a>
        <a class="card" href="https://iconsrg.printful.me"><div class="tag">Headwear</div><h3>Dad hats</h3><p>Low-profile caps for high theology. From about $18.</p><span class="go">Shop hats →</span></a>
        <a class="card" href="https://iconsrg.printful.me"><div class="tag">Barware</div><h3>Whiskey glasses</h3><p>For Wings, Whiskey &amp; the Word and beyond. From about $13.50.</p><span class="go">Shop glasses →</span></a>
      </div>
      <p style="text-align:center;color:var(--muted);font-size:15px;margin-top:28px;">
        Fulfilled by Printful. Prices and availability shown at checkout.
      </p>
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="narrow">
      <h2>Prefer to give directly?</h2>
      <p class="lead">Support the ministry with a one-time or recurring gift.</p>
      <div class="cta-row center" style="margin-top:24px;">
        <a class="btn btn-gold" href="/give/">Give a gift →</a>
      </div>
    </div>
  </section>

</Base>
