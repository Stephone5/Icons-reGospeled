---
import Base from '../layouts/Base.astro';
---
<Base title="Contact, Icons reGospeled" description="Get in touch with Icons reGospeled, State College, PA. Email, phone, and where to find us online.">

  <section class="hero" style="padding-bottom:0;">
    <div class="wrap">
      <p class="eyebrow">Say hello</p>
      <h1>We'd love to hear from you.</h1>
      <p class="lead">Questions, a story to share, or wondering where to start? Reach out, a real person reads these.</p>
    </div>
  </section>

  <section data-reveal>
    <div class="wrap">
      <div class="grid cols-2" style="max-width:900px;margin:0 auto;">
        <div class="card">
          <div class="tag">Get in touch</div>
          <h3>Email &amp; phone</h3>
          <p>
            <a class="textlink" href="mailto:jdkrider@iconsrg.org">jdkrider@iconsrg.org</a><br>
            <a class="textlink" href="tel:+18144097516">(814) 409-7516</a><br>
            State College, Pennsylvania
          </p>
          <span class="go">A 501(c)(3) Pennsylvania nonprofit</span>
        </div>
        <div class="card">
          <div class="tag">Find us online</div>
          <h3>Follow along</h3>
          <p>
            <a class="textlink" href="https://www.youtube.com/@LessHeresyThanExpected">YouTube, Less Heresy Than Expected</a><br>
            <a class="textlink" href="https://strengthenedbygrace.substack.com/">Substack, Strengthened by Grace</a><br>
            <a class="textlink" href="https://www.facebook.com/profile.php?id=61569046571090">Facebook</a><br>
            <a class="textlink" href="https://linktr.ee/iconsrg">Everything, linktr.ee/iconsrg</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section data-reveal>
    <div class="wrap" style="text-align:center;">
      <p class="eyebrow">The people</p>
      <div class="hosts" style="justify-content:center;">
        <div class="host"><img src="/assets/photos/jeremy.jpg" alt="Jeremy Krider" loading="lazy"><div><b>Jeremy Krider</b><span>Founder</span></div></div>
        <div class="host"><img src="/assets/photos/stephen-barton.jpg" alt="Stephen Barton" loading="lazy"><div><b>Stephen Barton</b><span>Co-host</span></div></div>
        <div class="host"><img src="/assets/photos/stephen-thor.jpg" alt="Stephen Thor" loading="lazy"><div><b>Stephen Thor</b><span>Host</span></div></div>
      </div>
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="narrow">
      <h2>Stay in touch.</h2>
      <p class="lead">Occasional letters and a good next book. No noise, unsubscribe anytime.</p>
      <form class="signup center" novalidate>
        <input type="email" placeholder="you@email.com" aria-label="Your email" autocomplete="email" required>
        <button class="btn btn-gold" type="submit">Subscribe</button>
      </form>
      <p class="form-msg" style="text-align:center;"></p>
    </div>
  </section>

</Base>
