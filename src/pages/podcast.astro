---
import Base from '../layouts/Base.astro';
---
<Base title="Podcast, Less Heresy Than Expected | Icons reGospeled" description="Less Heresy Than Expected, a YouTube podcast for deeper, freer, more honest Christian conversation. Plus the Strengthened by Grace Substack.">

  <section class="hero" style="padding-bottom:0;">
    <div class="wrap">
      <p class="eyebrow">The podcast</p>
      <h1>Less Heresy Than Expected</h1>
      <p class="lead">Deeper, freer, more honest Christian conversation, with warmth, wit, and theological depth. For thoughtful believers, doubters, and the disillusioned who suspect faith can be richer, stranger, and more beautiful than they were taught to expect.</p>
      <div class="cta-row center" style="margin-top:26px;">
        <a class="btn btn-gold" href="https://www.youtube.com/@LessHeresyThanExpected">Watch on YouTube →</a>
        <a class="btn btn-ghost" href="https://strengthenedbygrace.substack.com/">Read the Substack</a>
      </div>
      <div class="hosts" style="justify-content:center;margin-top:32px;">
        <div class="host"><img src="/assets/photos/jeremy.jpg" alt="Jeremy Krider" loading="lazy"><div><b>Jeremy Krider</b><span>Host</span></div></div>
        <div class="host"><img src="/assets/photos/stephen-barton.jpg" alt="Stephen Barton" loading="lazy"><div><b>Stephen Barton</b><span>Co-host</span></div></div>
      </div>
    </div>
  </section>

  <section data-reveal>
    <div class="narrow">
      <a class="poster" href="https://www.youtube.com/@LessHeresyThanExpected/videos">
        <div class="play">▶</div>
        <h2>Watch the latest episodes</h2>
        <p>Full interviews, shorter conversations, and clips, new on YouTube.</p>
      </a>
    </div>
  </section>

  <section class="section-alt" data-reveal>
    <div class="wrap two-col">
      <div>
        <p class="eyebrow">Also from Icons reGospeled</p>
        <h2>Strengthened by Grace</h2>
        <p>A Substack blog and podcast that helps Christians think more deeply, freely, and faithfully about God, the Church, and the human journey. Drawing from Scripture, Church history, theology, and lived experience, it opens space for honest reflection on faith, suffering, healing, and hope.</p>
        <p>The aim: to encourage you beyond shallow answers and into a more rooted, spacious, grace-filled vision of the Christian life.</p>
        <div class="cta-row" style="margin-top:20px;">
          <a class="btn btn-gold" href="https://strengthenedbygrace.substack.com/">Subscribe free →</a>
        </div>
      </div>
      <div class="grid">
        <div class="card"><div class="tag">On the show</div><h3>Guests &amp; scholars</h3><p>Long-form interviews with authors, theologians, and experts, plus shorter conversations and clips.</p></div>
        <div class="card"><div class="tag">What we explore</div><h3>The good stuff</h3><p>Scripture, Church history, spiritual formation, and the human struggle for healing and hope.</p></div>
      </div>
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="narrow">
      <h2>Never miss an episode.</h2>
      <p class="lead">Get new conversations and a good next book in your inbox.</p>
      <form class="signup center" novalidate>
        <input type="email" placeholder="you@email.com" aria-label="Your email" autocomplete="email" required>
        <button class="btn btn-gold" type="submit">Subscribe</button>
      </form>
      <p class="form-msg" style="text-align:center;"></p>
    </div>
  </section>

</Base>
