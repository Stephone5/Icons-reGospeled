---
import Base from '../layouts/Base.astro';
---
<Base title="Give — Icons reGospeled" description="Support Icons reGospeled — help keep the table set, the podcast running, and the library growing. A 501(c)(3) Pennsylvania nonprofit.">

  <section class="hero" style="padding-bottom:0;">
    <div class="wrap">
      <p class="eyebrow">Support the work</p>
      <h1>Help keep the table set.</h1>
      <p class="lead">Your giving sustains the gatherings, the podcast, the free Book Finder, the "Restoring the Icon" gifts, and our support of the State College Pregnancy Resource Clinic. Every gift furthers a gospel that heals.</p>
      <div class="cta-row center" style="margin-top:26px;">
        <a class="btn btn-gold" href="https://givebutter.com/icons-regospeled">Give a gift →</a>
      </div>
    </div>
  </section>

  <section data-reveal>
    <div class="wrap">
      <div class="grid cols-2" style="max-width:820px;margin:0 auto;">
        <a class="card" href="https://givebutter.com/icons-regospeled">
          <div class="tag">General giving</div>
          <h3>Support the ministry</h3>
          <p>One-time or recurring gifts that keep every part of Icons reGospeled going. Tax-deductible as allowed by law.</p>
          <span class="go">Give now →</span>
        </a>
        <a class="card" href="https://givebutter.com/GpWqP1">
          <div class="tag">Wings, Whiskey &amp; the Word</div>
          <h3>Cover a meal fee</h3>
          <p>Chipping in for a gathering? Take care of your meal contribution here.</p>
          <span class="go">Pay meal fee →</span>
        </a>
      </div>
      <p style="text-align:center;color:var(--muted);font-size:15px;max-width:60ch;margin:32px auto 0;">
        Icons reGospeled is a registered 501(c)(3) Pennsylvania nonprofit. For questions about giving, reach us at
        <a class="textlink" href="mailto:jdkrider@iconsrg.org">jdkrider@iconsrg.org</a>.
      </p>
    </div>
  </section>

  <section class="band" data-reveal>
    <div class="narrow">
      <h2>Another way to help: shop the merch.</h2>
      <p class="lead">Tees, dad hats, and whiskey glasses — "Apokatastasis" and more. Proceeds support the ministry.</p>
      <div class="cta-row center" style="margin-top:24px;">
        <a class="btn btn-gold" href="/shop/">Visit the shop →</a>
      </div>
    </div>
  </section>

</Base>
