---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const {
  title = 'Icons reGospeled, a gospel that heals',
  description = 'Icons reGospeled helps the wounded and the curious rediscover a gospel that heals, through honest theology, psychology, and real community. State College, PA · 501(c)(3) Pennsylvania nonprofit.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content="Icons reGospeled" />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <link rel="icon" href="/assets/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Epilogue:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/assets/brand.css" />
</head>
<body>
  <div class="scroll-progress" aria-hidden="true"><i></i></div>
  <div class="aurora" aria-hidden="true"><span class="c1"></span><span class="c2"></span><span class="c3"></span><span class="c4"></span></div>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />

  <script>
    import gsap from 'gsap';
    import ScrollTrigger from 'gsap/ScrollTrigger';

    // Progressive reveal, content is visible by default; only arm the hide
    // once JS is confirmed running, then reveal on scroll (with a failsafe).
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const els = [...document.querySelectorAll('[data-reveal]')];
    if (!reduce && 'IntersectionObserver' in window) {
      els.forEach((e) => e.classList.add('armed'));
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              en.target.classList.add('in');
              io.unobserve(en.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.06 }
      );
      els.forEach((e) => io.observe(e));
      setTimeout(() => els.forEach((e) => e.classList.add('in')), 1400);
    }

    // Before/after slider(s): vertical bar (drag left/right) on tablet+,
    // horizontal bar (drag up/down) on phones.
    document.querySelectorAll('.ba').forEach((ba) => {
      const knob = ba.querySelector('.ba-knob');
      if (!knob) return;
      let dragging = false;
      const phone = () => matchMedia('(max-width:640px)').matches;
      const setPos = (v) => {
        v = Math.max(0, Math.min(100, v));
        ba.style.setProperty('--pos', v + '%');
        knob.setAttribute('aria-valuenow', Math.round(v));
      };
      const setFromPoint = (x, y) => {
        const r = ba.getBoundingClientRect();
        setPos(phone() ? ((y - r.top) / r.height) * 100 : ((x - r.left) / r.width) * 100);
      };
      knob.setAttribute('role', 'slider');
      knob.setAttribute('aria-valuemin', '0');
      knob.setAttribute('aria-valuemax', '100');
      knob.setAttribute('aria-valuenow', '50');
      knob.tabIndex = 0;
      knob.addEventListener('pointerdown', (e) => { dragging = true; e.preventDefault(); });
      document.addEventListener('pointermove', (e) => { if (dragging) setFromPoint(e.clientX, e.clientY); });
      document.addEventListener('pointerup', () => { dragging = false; });
      ba.addEventListener('click', (e) => { if (!e.target.closest('.ba-knob')) setFromPoint(e.clientX, e.clientY); });
      knob.addEventListener('keydown', (e) => {
        const cur = parseFloat(ba.style.getPropertyValue('--pos')) || 50;
        if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { setPos(cur - 6); e.preventDefault(); }
        else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { setPos(cur + 6); e.preventDefault(); }
      });
    });

    // GSAP scroll-scrubbed motion (skipped for reduced-motion).
    if (!reduce) {
      gsap.registerPlugin(ScrollTrigger);
      // the Trinity motif turns + grows gently as you scroll through its section
      // Trinity motif: rotate + grow on scroll — plain calc so the pin can't throw it off.
      const trin = document.querySelector('.trinity svg');
      const trinSec = trin && trin.closest('section');
      if (trin && trinSec) {
        let ticking = false;
        const drawTrinity = () => {
          ticking = false;
          const r = trinSec.getBoundingClientRect();
          const vh = window.innerHeight || document.documentElement.clientHeight;
          let p = (vh - r.top) / (vh + r.height);
          p = Math.max(0, Math.min(1, p));
          trin.style.transformOrigin = '50% 50%';
          trin.style.transform = 'rotate(' + (-25 + p * 65) + 'deg) scale(' + (0.45 + p * 1.5) + ')';
        };
        const onT = () => { if (!ticking) { ticking = true; requestAnimationFrame(drawTrinity); } };
        addEventListener('scroll', onT, { passive: true });
        addEventListener('resize', onT);
        drawTrinity();
      }
      // soft scrubbed parallax on anything tagged data-parallax
      gsap.utils.toArray('[data-parallax]').forEach((el) => {
        const amt = parseFloat(el.getAttribute('data-parallax')) || 24;
        gsap.fromTo(
          el, { y: amt }, { y: -amt, ease: 'none',
            scrollTrigger: { trigger: el, start: 'top bottom', end: 'bottom top', scrub: 1, invalidateOnRefresh: true } }
        );
      });

      // Pinned scrollytelling for the Four Steps (desktop only): the section
      // locks while each step lights up in turn. Falls back to the normal
      // list on smaller screens.
      const plan = document.querySelector('#plan');
      const steps = plan ? gsap.utils.toArray('#plan .path li') : [];
      if (plan && steps.length && matchMedia('(min-width:900px)').matches) {
        gsap.set(steps, { opacity: 0.28, y: 12 });
        gsap.set(steps[0], { opacity: 1, y: 0 });
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: plan, start: 'center center',
            end: '+=' + steps.length * 55 + '%',
            pin: true, scrub: 0.6, anticipatePin: 1, invalidateOnRefresh: true,
          },
        });
        steps.forEach((s, i) => {
          if (i > 0) tl.to(s, { opacity: 1, y: 0, duration: 1 }, '+=0.5');
        });
      }

      // Recompute all positions after pins/images settle (fixes scroll effects
      // that sit below the pinned section on desktop).
      ScrollTrigger.refresh();
      window.addEventListener('load', () => ScrollTrigger.refresh());
    }

    // Scroll progress bar.
    const bar = document.querySelector('.scroll-progress i');
    if (bar) {
      const upd = () => {
        const h = document.documentElement;
        const max = h.scrollHeight - h.clientHeight;
        bar.style.width = (max > 0 ? (h.scrollTop / max) * 100 : 0) + '%';
      };
      addEventListener('scroll', upd, { passive: true });
      addEventListener('resize', upd);
      upd();
    }

    // Email signup -> Kit (ConvertKit) form 9754678 (same list the Book Finder uses).
    const KIT = 'https://app.kit.com/forms/9754678/subscriptions';
    document.querySelectorAll('form.signup').forEach((f) => {
      const input = f.querySelector('input[type=email]');
      const msg =
        (f.parentNode && f.parentNode.querySelector('.form-msg')) ||
        (() => {
          const m = document.createElement('p');
          m.className = 'form-msg';
          f.parentNode.appendChild(m);
          return m;
        })();
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = (input.value || '').trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)) {
          msg.style.color = '#b23b3b';
          msg.textContent = 'Please enter a valid email.';
          return;
        }
        try {
          fetch(KIT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'email_address=' + encodeURIComponent(v),
          }).catch(() => {});
        } catch (err) {}
        f.reset();
        input.disabled = true;
        msg.style.color = '';
        msg.textContent = "Thank you, you're on the list. Grace = peace.";
      });
    });

    // Open only EXTERNAL links in a new tab; internal links stay same-tab.
    document.querySelectorAll('a[href]').forEach((a) => {
      const h = a.getAttribute('href') || '';
      if (h.startsWith('#') || h.startsWith('mailto:') || h.startsWith('tel:')) return;
      if (a.hostname && a.hostname !== location.hostname) { a.target = '_blank'; a.rel = 'noopener'; }
    });
  </script>
</body>
</html>
